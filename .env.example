HOST=127.0.0.1
PORT=8787
GITHUB_WEBHOOK_PATH=/webhooks/github
GITHUB_WEBHOOK_SECRET=replace-with-the-secret-you-set-in-github

# Directory where every delivery, prompt, and agent log is stored.
WEBHOOK_EVENT_DIR=.webhook-events

# GitHub can send large push payloads. Raise this if needed.
MAX_BODY_BYTES=25000000

# Comma-separated allow-list. Leave empty to inspect every event type.
# Example: push,pull_request,issues,issue_comment,workflow_run
ALLOWED_EVENTS=

# Agent runner and selection.
# AGENT_RUNNER can be "superset" or "codex".
# $agent in text or label "agent" uses AGENT_DEFAULT. Leave AGENT_DEFAULT empty to use
# the selected runner's default: SUPERSET_DEFAULT_AGENT for Superset, CODEX_DEFAULT_MODEL for Codex.
# Direct text tags such as $codex, $claude, or $gpt-5.5, or matching labels, must be listed in AGENT_TAGS.
AGENT_RUNNER=superset
AGENT_TRIGGER_TAG=agent
AGENT_DEFAULT=
AGENT_TAGS=

# Superset runner invocation.
# Superset expects agent preset IDs or HostAgentConfig UUIDs, not raw model names.
# List local options with: superset agents list --local
SUPERSET_DEFAULT_AGENT=codex
SUPERSET_AGENT_TAGS=codex,claude
# If the server reports "spawn superset ENOENT", set this to the absolute path from `command -v superset`.
SUPERSET_COMMAND=superset
SUPERSET_WORKSPACE_ID=
SUPERSET_HOST_ID=
SUPERSET_EXTRA_ARGS_JSON=[]
SUPERSET_TERMINAL_POLL_INTERVAL_MS=10000
SUPERSET_TERMINAL_MAX_POLLS=360

# Superset receives a minimal environment by default. Add names here only when needed.
# SUPERSET_API_KEY and SUPERSET_API_URL are included by default when present.
SUPERSET_ENV_PASSTHROUGH_JSON=["SUPERSET_API_KEY","SUPERSET_API_URL"]

# Codex CLI runner invocation.
# Use AGENT_RUNNER=codex to run `codex exec` directly instead of Superset.
# $agent defaults to CODEX_DEFAULT_MODEL, and direct tags should be model names listed in AGENT_TAGS.
CODEX_COMMAND=codex
CODEX_DEFAULT_MODEL=gpt-5.5
CODEX_EXTRA_ARGS_JSON=[]
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=never
CODEX_WORKING_DIRECTORY=
CODEX_EXEC_TIMEOUT_MS=3600000

# Codex receives a minimal environment by default. Add names here only when needed.
CODEX_ENV_PASSTHROUGH_JSON=["OPENAI_API_KEY","CODEX_HOME"]

# GitHub response handling.
# The server uses gh to add an eyes reaction, post the agent output, add a completion reaction,
# and remove the eyes reaction. GitHub reactions do not support a literal checkmark.
GITHUB_RESPONSE_ENABLED=true
GITHUB_CONTEXT_ENABLED=true
GITHUB_CONTEXT_INLINE_MAX_BYTES=120000
GITHUB_COMMAND=gh
GITHUB_COMPLETION_REACTION=+1
GITHUB_ENV_PASSTHROUGH_JSON=["GH_TOKEN","GITHUB_TOKEN","GH_HOST"]

# Useful while testing the webhook without launching an agent.
DRY_RUN=false

# Optional text prepended to every generated agent prompt.
AGENT_PROMPT_PREFIX=
